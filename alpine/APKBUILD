# -*- mode: Shell-script; eval: (setq indent-tabs-mode 't); eval: (setq tab-width 4) -*-
# Maintainer: Dominic Meiser <git@msrd0.de>
pkgname=nfc_backend
pkgver=%pkgver%
pkgrel=0
pkgdesc="MateKiosk NFC Backend"
url="https://msrd0.dev/matekeller/matekiosk-nfc-backend"
arch="aarch64"
license="custom"

subpackages="$pkgname-openrc::noarch"

makedepends_host="cargo rust-stdlib-aarch64 pcsc-lite-dev"
makedepends_build="gcc pcsc-lite-dev"

source="nfc_backend.init nfc_backend-$pkgver.crate"
builddir="$srcdir"

prepare() {
	default_prepare

	tar xfz "nfc_backend-$pkgver.crate"
	cat >>"nfc_backend-$pkgver/Cargo.toml" <<EOF
# make sure the package doesn't think it's part of a workspace
[workspace]

# turn on size optimizations
[profile.release]
lto = true
opt-level = "z"
EOF
}

build() {
	cargo build \
		--manifest-path "nfc_backend-$pkgver/Cargo.toml" \
		--locked \
		--release \
		--target-dir "$srcdir"/target \
		--target "$CTARGET"
}

package() {
	mkdir -p "$pkgdir"/usr/bin
	install -m755 "$srcdir/target/$CTARGET"/release/nfc_backend "$pkgdir"/usr/bin
	install -D -m755 "$srcdir/nfc_backend.init" "$pkgdir"/etc/init.d/nfc_backend
}
